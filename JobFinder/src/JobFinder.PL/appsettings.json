{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=JobFinderDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "JwtConfig": {
    "Issuer": "JobFinder",
    "Audience": "JobFinder.Client",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays"  : 7
  }
}
